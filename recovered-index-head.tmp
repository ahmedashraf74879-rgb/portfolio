    <script>
      (() => {
        const key = "ahmed-portfolio-welcome-seen-v3";
        const restoreKey = `ahmedPortfolioRestorePending:${location.pathname}`;
        const navigation = performance.getEntriesByType("navigation")[0];
        const isHistoryReturn = navigation?.type === "back_forward";

        try {
          const returning = sessionStorage.getItem(key) === "1" || Boolean(window.location.hash);
          const restorePending = sessionStorage.getItem(restoreKey) === "1" || isHistoryReturn;
          if (returning) document.documentElement.classList.add("welcome-seen");
          if (restorePending) document.documentElement.classList.add("history-return-pending");
          sessionStorage.setItem(key, "1");
        } catch {
          if (window.location.hash) document.documentElement.classList.add("welcome-seen");
          if (isHistoryReturn) document.documentElement.classList.add("history-return-pending");
        }
      })();
    </script>
